" fzf sink: ctrl-l in :Files sends all candidates to the quickfix
" select-all + a print marker lets the sink tell ctrl-l apart from Enter
function! s:fzf_files_sink(lines) abort
  if get(a:lines, 1, '') ==# 'FZF-QF'
    call setqflist(map(a:lines[2:], '{"filename": fnamemodify(v:val, ":p"), "lnum": 1, "text": ""}'))
    copen
    return
  endif
  let pkey = get(get(g:, 'fzf_vim', {}), 'paste_key', 'alt-enter')
  if get(a:lines, 0, '') ==# pkey
    return fzf#vim#paste(a:lines[1:])
  endif
  for f in a:lines[1:]
    execute 'edit' fnameescape(f)
  endfor
endfunction

function! s:fzf_files_qf(arg, bang) abort
  call fzf#vim#files(a:arg, extend(fzf#vim#with_preview(), {'sink*': function('s:fzf_files_sink')}), a:bang)
endfunction

" Focus quickfix window after ctrl-l
function! s:fzf_listproc_qf(list) abort
  call setqflist(a:list)
  copen
endfunction
let g:fzf_vim = extend(get(g:, 'fzf_vim', {}), {'listproc': function('s:fzf_listproc_qf')})

function! s:qf_sink(line)
  let parts = matchlist(a:line, '\v^(.{-}):(\d+):(.*)$')
  execute 'edit' fnameescape(parts[1])
  call cursor(parts[2], 0)
endfunction

" fzf browser over the current quickfix list
function! s:quickfix_fzf()
  let qf = getqflist()
  if empty(qf) | echo 'Quickfix is empty' | return | endif
  let source = map(qf, {_, e -> empty(bufname(e.bufnr)) ? e.filename : bufname(e.bufnr) . ':' . e.lnum . ':' . e.text})
  call fzf#run(fzf#wrap({'source': source, 'sink': function('s:qf_sink')}))
endfunction

