" ------------------------------------------------------------------------------
" Options
" ------------------------------------------------------------------------------

let g:netrw_home = $XDG_DATA_HOME."/vim"

syntax on
filetype plugin indent on
set autoread
set hidden
set number
set relativenumber
set numberwidth=2
set cursorline
" set autoindent " Minimal automatic indenting for any filetype.
set backspace=indent,eol,start " Intuitive backspace behavior.

set nolist
set listchars=space:·,tab:>-,trail:·,nbsp:+,eol:↵
set fillchars+=eob:\

set tabstop=4
set softtabstop=4
set shiftwidth=4
set expandtab
set smarttab

set hlsearch
set incsearch
set ignorecase
set smartcase

set wrap
set whichwrap+=<,>,[,]
set virtualedit=block
set scrolloff=10
set sidescrolloff=8
set laststatus=2
set ttimeoutlen=20
set timeoutlen=400
set path+=**
set wildignore+=*/node_modules/*
set wildmenu
set wildmode=longest:full,full
set synmaxcol=400
set signcolumn=auto
set foldcolumn=1
set foldlevelstart=30

set smoothscroll
set splitkeep=screen
set jumpoptions=stack

set linebreak
set breakindent
set mouse=a
set splitright splitbelow

" set lazyredraw
set termguicolors

set undodir=$XDG_DATA_HOME/vim/undo//
set undofile
set undolevels=1500

set viminfofile=$XDG_DATA_HOME/vim/viminfo

call mkdir($XDG_DATA_HOME.'/vim/undo', 'p')

" % jumps across if/else/endif, HTML tags
packadd! matchit

" Use a line cursor within insert mode and a block cursor everywhere else.
" Reference chart of values:
"   Ps = 0  -> blinking block.
"   Ps = 1  -> blinking block (default).
"   Ps = 2  -> steady block.
"   Ps = 3  -> blinking underline.
"   Ps = 4  -> steady underline.
"   Ps = 5  -> blinking bar (xterm).
"   Ps = 6  -> steady bar (xterm).
let &t_SI = "\e[6 q"
let &t_EI = "\e[2 q"
let &t_te .= "\e[2 q"

