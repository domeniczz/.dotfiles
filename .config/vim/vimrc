" ------------------------------------------------------------------------------
" Key mappings
" ------------------------------------------------------------------------------

let mapleader = " "

nnoremap <silent> Q :call KillBufferOrCloseWindow()<CR>

" <Esc> clears search highlight
nnoremap <silent> <Esc> :nohlsearch<CR>

" Move selected lines up/down (keeps selection)
vnoremap <silent> K :move '<-2<CR>gv=gv
vnoremap <silent> J :move '>+1<CR>gv=gv

" Keep cursor centered while scrolling/searching
nnoremap <silent> <C-d> <C-d>zz
nnoremap <silent> <C-u> <C-u>zz
nnoremap <silent> n nzzzv
nnoremap <silent> N Nzzzv

" Keep cursor in place while joining lines
nnoremap <silent> J mzJ`z

" Y behaves like C and D
nnoremap Y y$

" Paste over without losing the register
xnoremap p "_dP

" Delete to the black hole register (leader+d)
nnoremap <silent> <leader>d "_d
vnoremap <silent> <leader>d "_d

" System clipboard: <space>y/Y to copy, <space>p/P to paste
" (plain y/p use vim's internal registers)
nnoremap <silent> <leader>y "+y
vnoremap <silent> <leader>y "+y
nnoremap <silent> <leader>Y "+Y
vnoremap <silent> <leader>Y "+Y
nnoremap <silent> <leader>p "+p
vnoremap <silent> <leader>p "+p
nnoremap <silent> <leader>P "+P
vnoremap <silent> <leader>P "+P

" Alt+h/l buffer switching, Alt+j/k quickfix navigation
nnoremap <silent> <M-h> :bprevious<CR>
nnoremap <silent> <M-l> :bnext<CR>
nnoremap <silent> <M-j> :cnext<CR>
nnoremap <silent> <M-k> :cprev<CR>

" Replace word under cursor (Ctrl-S)
nnoremap <C-s> :%s/<C-r><C-w>/<C-r><C-w>/gIc<Left><Left><Left><Left>
vnoremap <C-s> :s///gIc<Left><Left><Left><Left><Left>

" Toggle invisible characters
nnoremap <silent> <leader>tl :set list!<CR>

" Make current file executable
nnoremap <silent> <leader>x :!chmod +x %<CR>

" Yank the whole file to the system clipboard
nnoremap <silent> <leader>[ :%yank +<CR>

" Disable arrow keys (forces hjkl navigation)
nnoremap <Up> <Nop>
nnoremap <Down> <Nop>
nnoremap <Left> <Nop>
nnoremap <Right> <Nop>
inoremap <Up> <Nop>
inoremap <Down> <Nop>
inoremap <Left> <Nop>
inoremap <Right> <Nop>
vnoremap <Up> <Nop>
vnoremap <Down> <Nop>
vnoremap <Left> <Nop>
vnoremap <Right> <Nop>

