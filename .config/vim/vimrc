" Trim trailing whitespace and empty lines on save
function! s:trim_trailing() abort
  if !&modifiable || line('$') > 10000
    return
  endif
  let l:save = winsaveview()
  if &filetype !=# 'markdown'
    silent! keeppatterns %s/\s\+$//e
  endif
  silent! keeppatterns %s/\($\n\s*\)\+\%$//e
  call winrestview(l:save)
endfunction
augroup trim_trailing
  autocmd!
  autocmd BufWritePre * call s:trim_trailing()
augroup END

" Drop expensive features for very large files
function! s:large_file_init() abort
  if getfsize(expand('%:p')) > 5 * 1024 * 1024
    let b:is_large_file = 1
    setlocal noswapfile noundofile nospell foldmethod=manual
  endif
endfunction
augroup large_file
  autocmd!
  autocmd BufReadPre * call s:large_file_init()
  autocmd BufReadPost * if exists('b:is_large_file') | setlocal syntax= | endif
augroup END

