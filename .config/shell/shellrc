function condainit() {
    _conda_base=$(command conda info --base 2>/dev/null)
    if [ -n "$_conda_base" ]; then
        . "$_conda_base/etc/profile.d/conda.sh"
        unset _conda_base
        return
    fi
    for _conda_dir in "$HOME" "$HOME/Programs" /opt /usr/local; do
        for _conda_name in miniconda3 miniconda anaconda3 anaconda miniforge3 mambaforge; do
            _conda_sh="$_conda_dir/$_conda_name/etc/profile.d/conda.sh"
            [ -r "$_conda_sh" ] && . "$_conda_sh" && unset _conda_base _conda_dir _conda_name _conda_sh && return
        done
    done
    for _conda_sh in /opt/homebrew/Caskroom/miniconda/base/etc/profile.d/conda.sh /usr/local/Caskroom/miniconda/base/etc/profile.d/conda.sh /etc/profile.d/conda.sh; do
        [ -r "$_conda_sh" ] && . "$_conda_sh" && unset _conda_base _conda_dir _conda_name _conda_sh && return
    done
    unset _conda_base _conda_dir _conda_name _conda_sh
    return 1
}

# Initialize conda automatically on the first `conda` command
function conda() {
    condainit || return
    conda "$@"
}

# Initialize nvm efficiently
export NVM_DIR="$HOME/.nvm"
[[ -s "$NVM_DIR/nvm.sh" ]] || NVM_DIR="$HOME/.local/share/nvm"
[[ -s "$NVM_DIR/alias/default" ]] && {
    _nvm_version=$(<"$NVM_DIR/alias/default")
    export PATH="$NVM_DIR/versions/node/v${_nvm_version#v}/bin:$PATH"
    unset _nvm_version
}
_nvm_completion="$NVM_DIR/bash_completion"
[ -s "$_nvm_completion" ] || _nvm_completion="${HOMEBREW_PREFIX-}/opt/nvm/etc/bash_completion.d/nvm"
if [ -n "${ZSH_VERSION-}" ]; then
    zsh-defer source "$NVM_DIR/nvm.sh" --no-use
    [ -s "$_nvm_completion" ] && zsh-defer source "$_nvm_completion"
else
    source "$NVM_DIR/nvm.sh" --no-use
    [ -s "$_nvm_completion" ] && source "$_nvm_completion"
fi
unset _nvm_completion

# Change current working directory when exiting Yazi
function yazicd() {
    local tmp="$(mktemp -t "yazi-cwd.XXXXXX")" cwd
    yazi "$@" --cwd-file="$tmp"
    if cwd="$(cat -- "$tmp")" && [[ -n "$cwd" ]] && [[ "$cwd" != "$PWD" ]]; then
        builtin cd -- "$cwd"
    fi
    rm -f -- "$tmp"
}

# Change current working directory when exiting Vifm
function vifmcd() {
    local dst="$(vifm --choose-dir - "$@")"
    if [[ -z "$dst" ]]; then
        echo 'Directory picking cancelled/failed'
        return 1
    fi
    cd "$dst"
}

# Unmount and power off a USB drive
function unmount() {
    local disks count disk choice mounted dev
    local size_model mounts
    if ! command -v lsblk >/dev/null 2>&1 || ! command -v udisksctl >/dev/null 2>&1; then
        echo "Requires lsblk and udisksctl"
        return 1
    fi
    disks="$(lsblk -dpnr -o NAME,TYPE,TRAN | awk '$2 == "disk" && $3 == "usb" { print $1 }')"
    if [[ -z "$disks" ]]; then
        echo "No USB drives found"
        return 1
    fi
    count="$(printf '%s\n' "$disks" | wc -l | tr -d '[:space:]')"
    if (( count == 1 )); then
        disk="$disks"
    else
        if ! command -v fzf >/dev/null 2>&1; then
            echo "Multiple USB drives found, but fzf is not installed"
            printf '%s\n' "$disks"
            return 1
        fi
        choice="$(
            while IFS= read -r disk; do
                size_model="$(lsblk -dnro SIZE,MODEL "$disk")"
                mounts="$(lsblk -nrpo MOUNTPOINT "$disk" | awk 'NF { out = out (out ? ", " : "") $0 } END { print out }')"
                [[ -n "$mounts" ]] || mounts="not mounted"
                printf '%s\t%s\t%s\n' "$disk" "$size_model" "$mounts"
            done <<< "$disks" | fzf --prompt='USB drive> ' --height=40% --reverse
        )"
        [[ -n "$choice" ]] || return 1
        disk="${choice%%$'\t'*}"
    fi
    mounted="$(lsblk -rpn -o NAME,MOUNTPOINT "$disk" | awk '$2 != "" { print $1 }')"
    while IFS= read -r dev; do
        [[ -n "$dev" ]] || continue
        udisksctl unmount -b "$dev" || return 1
    done <<< "$mounted"
    udisksctl power-off -b "$disk"
}
