{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "plugin": [
    // "superpowers@git+https://github.com/obra/superpowers.git",
    "@tarquinen/opencode-dcp@latest",
    "@dietrichgebert/ponytail"
  ],
  "watcher": {
    "ignore": [
      ".git/",
      "node_modules/",
      "dist/",
      "pycache/",
      ".venv/",
      "venv/",
      ".pytest_cache/",
      ".vscode/",
      ".idea/"
    ]
  },
  "permission": {
    "read": {
      ".env": "allow",
      ".env.*": "allow",
      ".env-*": "allow"
    },
    "external_directory": "allow",
    "edit": {
      "~/Library/**": "deny",
      "/System/**": "deny",
      "/usr/**": "deny",
      "/etc/**": "deny",
      "/var/**": "deny",
      "/bin/**": "deny",
      "/sbin/**": "deny",
      "/opt/**": "deny",
      "/Library/**": "deny",
      "~/.ssh/**": "deny",
      "~/.gnupg/**": "deny",
      "~/.aws/**": "deny",
      "~/.config/**": "ask"
    },
    "bash": {
      "sudo *": "deny",
      "rm -rf /": "deny",
      "rm -rf /*": "deny",
      "rm -rf ~": "deny",
      "rm -rf ~/*": "deny",
      "brew install *": "ask",
      "brew uninstall *": "ask",
      "apt install *": "ask",
      "apt remove *": "ask",
      "apt purge *": "ask",
      "apt-get install *": "ask",
      "apt-get remove *": "ask",
      "apt-get purge *": "ask",
      "dpkg -i *": "ask",
      "dpkg -r *": "ask",
      "yum install *": "ask",
      "yum remove *": "ask",
      "dnf install *": "ask",
      "dnf remove *": "ask",
      "pacman -S *": "ask",
      "pacman -R *": "ask",
      "pacman -U *": "ask",
      "zypper install *": "ask",
      "zypper remove *": "ask",
      "apk add *": "ask",
      "apk del *": "ask",
      "snap install *": "ask",
      "snap remove *": "ask",
      "port install *": "ask",
      "port uninstall *": "ask",
      "nix-env -i *": "ask",
      "nix-env -e *": "ask",
      "nix profile install *": "ask",
      "choco install *": "ask",
      "choco uninstall *": "ask",
      "winget install *": "ask",
      "winget uninstall *": "ask",
      "scoop install *": "ask",
      "scoop uninstall *": "ask",
      "npm install *": "ask",
      "npm install -g *": "ask",
      "npm uninstall *": "ask",
      "pnpm add *": "ask",
      "pnpm remove *": "ask",
      "yarn add *": "ask",
      "yarn remove *": "ask",
      "bun add *": "ask",
      "bun remove *": "ask",
      "pip install *": "ask",
      "pip uninstall *": "ask",
      "pip3 install *": "ask",
      "pip3 uninstall *": "ask",
      "uv add *": "ask",
      "uv pip install *": "ask",
      "uv pip uninstall *": "ask",
      "pipx install *": "ask",
      "pipx uninstall *": "ask",
      "cargo install *": "ask",
      "cargo uninstall *": "ask",
      "go install *": "ask",
      "git commit *": "ask",
      "git push *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask"
    }
  },
  "agent": {
    "inspect": {
      "description": "Researches, reviews, and inspects local projects and online sources without modifying anything.",
      "mode": "all",
      "permission": {
        "*": "allow",
        "edit": "deny",
        "bash": {
          "*": "allow",
          "*>*": "ask",
          "*>>*": "ask",
          "rm *": "deny",
          "rmdir *": "deny",
          "shred *": "deny",
          "unlink *": "deny",
          "mv *": "ask",
          "cp *": "ask",
          "mkdir *": "ask",
          "touch *": "ask",
          "ln *": "ask",
          "truncate *": "ask",
          "dd *": "deny",
          "tee *": "ask",
          "install *": "ask",
          "patch *": "ask",
          "sed -i*": "ask",
          "perl -i*": "ask",
          "chmod *": "deny",
          "chown *": "deny",
          "chgrp *": "deny",
          "chflags *": "deny",
          "xattr -w*": "deny",
          "find * -delete*": "ask",
          "find * -exec*": "ask",
          "find * -ok*": "ask",
          "xargs *": "ask",
          "sudo *": "deny",
          "su *": "deny",
          "doas *": "deny",
          "eval *": "ask",
          "sh -c*": "ask",
          "bash -c*": "ask",
          "zsh -c*": "ask",
          "python -c*": "ask",
          "python3 -c*": "ask",
          "node -e*": "ask",
          "ruby -e*": "ask",
          "perl -e*": "ask",
          "osascript*": "ask",
          "kill*": "deny",
          "pkill*": "deny",
          "launchctl *": "deny",
          "systemctl *": "deny",
          "defaults write*": "deny",
          "networksetup *": "deny",
          "systemsetup *": "deny",
          "diskutil *": "deny",
          "mount *": "deny",
          "umount *": "deny",
          "softwareupdate *": "deny",
          "csrutil *": "deny",
          "spctl *": "deny",
          "crontab *": "deny",
          "brew install*": "ask",
          "brew uninstall*": "ask",
          "brew upgrade*": "ask",
          "npm install*": "ask",
          "npm i *": "ask",
          "npm uninstall*": "ask",
          "npm publish*": "deny",
          "npx *": "ask",
          "pnpm add*": "ask",
          "pnpm install*": "ask",
          "bun add*": "ask",
          "bun install*": "ask",
          "yarn add*": "ask",
          "pip install*": "ask",
          "pip3 install*": "ask",
          "pip uninstall*": "ask",
          "uv add*": "ask",
          "uv pip install*": "ask",
          "poetry add*": "ask",
          "gem install*": "ask",
          "cargo install*": "ask",
          "cargo add*": "ask",
          "go install*": "ask",
          "go get*": "ask",
          "apt *": "deny",
          "apt-get *": "deny",
          "git add*": "ask",
          "git am*": "ask",
          "git apply*": "ask",
          "git branch -d*": "ask",
          "git branch -D*": "ask",
          "git checkout*": "ask",
          "git cherry-pick*": "ask",
          "git clean*": "deny",
          "git commit*": "ask",
          "git config *": "ask",
          "git config --get*": "allow",
          "git config --list*": "allow",
          "git fetch*": "ask",
          "git filter-branch*": "deny",
          "git gc*": "ask",
          "git init*": "ask",
          "git merge*": "ask",
          "git mv*": "ask",
          "git prune*": "ask",
          "git pull*": "ask",
          "git push*": "ask",
          "git rebase*": "ask",
          "git remote add*": "ask",
          "git remote remove*": "ask",
          "git reset*": "deny",
          "git restore*": "deny",
          "git revert*": "ask",
          "git rm*": "deny",
          "git stash*": "ask",
          "git submodule*": "ask",
          "git switch*": "ask",
          "git tag -d*": "ask",
          "git worktree*": "ask",
          "git diff --output*": "deny",
          "git diff --ext-diff*": "deny",
          "git show --output*": "deny",
          "gh * create*": "ask",
          "gh * delete*": "deny",
          "gh * edit*": "ask",
          "gh * merge*": "ask",
          "gh * close*": "ask",
          "gh * -X*": "ask",
          "gh release *": "ask",
          "gh workflow run*": "ask",
          "curl *-o*": "ask",
          "curl *-O*": "ask",
          "curl *-X*": "ask",
          "curl *-d*": "ask",
          "curl *--data*": "ask",
          "curl *-T*": "ask",
          "curl *--upload-file*": "ask",
          "curl *-F*": "ask",
          "wget *": "ask",
          "ssh *": "ask",
          "scp *": "ask",
          "rsync *": "ask",
          "nc *": "ask",
          "docker *": "ask",
          "docker ps*": "allow",
          "docker images*": "allow",
          "docker logs*": "allow",
          "docker inspect*": "allow",
          "kubectl *": "ask",
          "kubectl get*": "allow",
          "kubectl describe*": "allow",
          "kubectl logs*": "allow",
          "terraform *": "ask",
          "terraform plan*": "allow",
          "terraform show*": "allow"
        }
      },
      "prompt": "You are a read-only inspection agent. Handle local codebase research, online research, code reviews, architecture inspections, debugging analysis, and security inspections. Use read-only tools freely, prefer official and primary web sources, and distinguish facts from inference. Report findings first when reviewing code, ordered by severity with file and line references. Never edit, write, delete, rename, install, commit, push, or run any mutating command, even if a task appears to require it. If a requested action would mutate state, explain what would be needed instead."
    }
  },
  "mcp": {
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  }
}
